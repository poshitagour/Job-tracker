# LinkedIn credentials
LINKEDIN_EMAIL=your_email@gmail.com
LINKEDIN_PASSWORD=your_password

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Telegram notifications (get from @BotFather on Telegram)
# 1. Message @BotFather, do /newbot, get token
# 2. Message your bot once, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to get your chat_id
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Gmail SMTP digest (GitHub Actions secrets — not committed)
# 1. Enable 2FA on Google Account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Add repo secrets: GMAIL_ADDRESS, GMAIL_APP_PASSWORD, optional EMAIL_TO
# Optional repo variable: PAGES_URL=https://poshitagour.github.io/Job-tracker/
GMAIL_ADDRESS=poshitagour121@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_TO=poshitagour121@gmail.com
